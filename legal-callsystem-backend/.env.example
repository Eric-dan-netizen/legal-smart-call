# 应用配置
NODE_ENV=development
PORT=3000
APP_NAME=legal-callsystem

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=legal_call_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 配置
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=7d

# 阿里云通信服务配置
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_CALL_APP_KEY=
ALIYUN_CALL_NUMBER=

# 阿里云 OSS 配置 (录音存储)
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_OSS_ACCESS_KEY=
ALIYUN_OSS_SECRET_KEY=

# 企业微信配置
WECHAT_CORP_ID=
WECHAT_AGENT_ID=
WECHAT_SECRET=

# TTS 服务配置 (可选)
TTS_PROVIDER=azure  # aliyun | azure
TTS_API_KEY=

# Azure 语音服务配置 (TTS + ASR)
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=eastus

# ASR 语音识别配置
ASR_PROVIDER=aliyun  # aliyun | iflytek
ASR_APP_ID=
ASR_API_KEY=

# LLM 对话服务配置 (硅基流动)
LLM_API_BASE=https://api.siliconflow.cn/v1
LLM_API_KEY=your_siliconflow_api_key
LLM_MODEL=deepseek-ai/DeepSeek-V2-Chat

# 多租户配置
TENANT_ENCRYPTION_KEY=your_encryption_key_32chars
